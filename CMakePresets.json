{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "win-msvc-debug",
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "Windows MSVC Debug (Ninja)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "win-msvc-release",
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "Windows MSVC Release (Ninja)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "Linux GCC/Clang Debug (Ninja)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "generator": "Ninja",
      "displayName": "Linux GCC/Clang Release (Ninja)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "win-msvc-debug", "configurePreset": "win-msvc-debug" },
    { "name": "win-msvc-release", "configurePreset": "win-msvc-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "win-msvc-release",
      "configurePreset": "win-msvc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
